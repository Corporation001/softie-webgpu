    "test:game:flow": "node tests/calm-match.browser.mjs",
    "test:game:layout": "node tests/calm-layout.browser.mjs",
    "test:game:loading": "node tests/calm-match.loading.mjs",
    "test:game:stress": "node tests/calm-match.stress.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
